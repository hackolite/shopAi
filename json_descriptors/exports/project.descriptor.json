{
  "id": "project-json",
  "exportFileName": "project.json",
  "description": "Project metadata stored per project and exported inside the project ZIP.",
  "exportChannels": [
    {
      "type": "zip-entry",
      "endpoint": "GET /api/cad/projects/{project_id}/export",
      "entryName": "project.json"
    }
  ],
  "rootSchema": {
    "type": "object",
    "required": [
      "id",
      "name",
      "createdAt",
      "updatedAt"
    ],
    "optional": []
  },
  "fieldTypes": {
    "id": "string",
    "name": "string",
    "createdAt": "ISO-8601 UTC datetime string",
    "updatedAt": "ISO-8601 UTC datetime string"
  },
  "aiHints": [
    "Treat id as the persistent project identifier.",
    "Timestamps are UTC ISO-8601 strings.",
    "This file is metadata only and does not contain store geometry or products."
  ],
  "examplePaths": [
    "backend/storage/projects/retail_cad/project.json"
  ]
}
