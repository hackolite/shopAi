# Required: backend métier URL
BACKEND_BASE_URL=http://localhost:8000

# LLM provider: none | openai | anthropic | xai | openrouter
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
XAI_API_KEY=
XAI_MODEL=grok-4
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional OpenRouter attribution headers
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=

# Authentication uses the forwarded ShopAI session; no shared webhook secret.

# HTTP behavior
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3
COLLISION_MAX_RETRIES=6
COLLISION_OFFSET_CM=20

# Optional: custom assortment file for step 6
CATALOG_JSON_PATH=
