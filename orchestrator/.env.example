# Required: backend métier URL
BACKEND_BASE_URL=http://localhost:8000

# LLM provider: none | openai | anthropic
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Webhook security (must match backend STUDIO_LLM_WEBHOOK_TOKEN when used)
WEBHOOK_AUTH_TOKEN=

# HTTP behavior
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3
COLLISION_MAX_RETRIES=6
COLLISION_OFFSET_CM=20

# Optional: custom assortment file for step 6
CATALOG_JSON_PATH=
